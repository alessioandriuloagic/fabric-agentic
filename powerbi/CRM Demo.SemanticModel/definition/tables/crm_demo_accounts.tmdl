table crm_demo_accounts

    measure 'Account Count' = COUNTROWS(crm_demo_accounts)
        formatString: #,##0

    column accountid
        dataType: string
        summarizeBy: none
        sourceColumn: accountid

    column name
        dataType: string
        sourceColumn: name

    column modifiedon
        dataType: dateTime
        summarizeBy: none
        sourceColumn: modifiedon

    partition crm_demo_accounts = entity
        mode: directLake
        source
            entityName: crm_demo_accounts
            schemaName: dbo
            expressionSource: DL_Lakehouse